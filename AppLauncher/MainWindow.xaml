<Window x:Class="AppLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:local="clr-namespace:AppLauncher"
        mc:Ignorable="d"
        Closing="WindowClosing" 
        ResizeMode="CanMinimize"
        Title="AppLauncher" Height="700" Width="1000" Background="#FF3E6FB3" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Image x:Name="Logo" HorizontalAlignment="Left" Height="141" Margin="814,513,0,0" VerticalAlignment="Top" Width="159" Source="/Icon/rocket.png"/>
        <TabControl x:Name="Log" HorizontalAlignment="Left" Height="172" Margin="5,485,0,0" VerticalAlignment="Top" Width="790" Background="#FFE6F0FF">
            <TabControl.Resources>
                <Style TargetType="RichTextBox">
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                </Style>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                </Style>
            </TabControl.Resources>
            <TabItem Header="一般" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxGeneral" Background="#FF43B5BF"/>
            </TabItem>
            <TabItem Header="警告" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxWarning" Background="#FF43AABF"/>
            </TabItem>
            <TabItem Header="錯誤" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxError" Background="#FF43A0BF"/>
            </TabItem>
            <TabItem Header="除錯" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxDebug" Background="#FF4396BF"/>
            </TabItem>
        </TabControl>
        <TabControl HorizontalAlignment="Left" Margin="5,3,0,0" VerticalAlignment="Top" Height="478" Width="978" Background="#FFE6F0FF">
            <TabItem Header="主畫面" Style="{StaticResource BaseTabcontrol}">
                <Grid>
                    <WrapPanel Orientation="Horizontal" Margin="130,36,91,243">
                        <Button x:Name="Open_RTSP" Style="{StaticResource FileButton}" Margin="0,0,0,0" FontSize="18" Height="80" Width="80" Click="Main_Btn_Click"/>
                        <TextBox x:Name="RTSP_Path" Style="{StaticResource BaseTextBox}" Tag="請開啟RTSP URL CSV路徑!" FontSize="18" Height="40" Width="650" Margin="10,0,0,0"/>
                        <Button x:Name="Open_VLCPath" Style="{StaticResource FileButton}" Margin="0,0,0,0" FontSize="18" Height="80" Width="80" Click="Main_Btn_Click"/>
                        <TextBox x:Name="VLCPath" Style="{StaticResource BaseTextBox}" Tag="請開啟vlc.exe路徑!" FontSize="18" Height="40" Width="650" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <GroupBox Style="{StaticResource BaseGroupBox}" Margin="133,224,442,38" Header="視窗位置設定" FontSize="22" Background="Green">
                        <WrapPanel Orientation="Horizontal" Margin="-8,-8,-9,-8">
                            <Label x:Name="Window_X_Label" Content="X座標︰" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Margin="10,0,0,0"/>
                            <xctk:IntegerUpDown x:Name="Window_X" Minimum="0" TextAlignment="Center" FontSize="20" Width="100" Height="40" Margin="0,0,0,0"/>
                            <Label x:Name="Window_Y_Label" Content="Y座標︰" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Margin="10,0,0,0"/>
                            <xctk:IntegerUpDown x:Name="Window_Y" Minimum="0" TextAlignment="Center" FontSize="20" Width="100" Height="40" Margin="0,5,0,0"/>
                            <Label x:Name="Window_Width_Label" Content="寬度︰" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Margin="21,0,0,0"/>
                            <xctk:IntegerUpDown x:Name="Window_Width" Minimum="1" TextAlignment="Center" FontSize="20" Width="100" Height="40" Margin="0,5,0,0"/>
                            <Label x:Name="Window_Height_Label" Content="長度︰" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Margin="21,0,0,0"/>
                            <xctk:IntegerUpDown x:Name="Window_Height" Minimum="1" TextAlignment="Center" FontSize="20" Width="100" Height="40" Margin="0,5,0,0"/>
                            <Label x:Name="Gap_Width_Label" Content="間隔寬︰" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Margin="3,0,0,0"/>
                            <xctk:IntegerUpDown x:Name="Gap_Width" Minimum="1" TextAlignment="Center" FontSize="20" Width="100" Height="40" Margin="0,5,0,0"/>
                            <Label x:Name="Gap_Height_Label" Content="間隔長︰" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Margin="3,0,0,0"/>
                            <xctk:IntegerUpDown x:Name="Gap_Height" Minimum="1" TextAlignment="Center" FontSize="20" Width="100" Height="40" Margin="0,5,0,0"/>
                        </WrapPanel>
                    </GroupBox>
                    <WrapPanel Orientation="Vertical" Margin="617,265,118,78">
                        <Button x:Name="VLC" Style="{StaticResource CircleButton}" Margin="0,0,0,0" Content="VLC" FontSize="18" Height="100" Width="100" Click="Main_Btn_Click"/>
                        <Button x:Name="Save_Config" Style="{StaticResource CircleButton}" Margin="30,0,0,0" Content="Config" FontSize="18" Height="100" Width="100" Click="Main_Btn_Click"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="關於" Style="{StaticResource BaseTabcontrol}" PreviewMouseLeftButtonDown="About_Click"/>
        </TabControl>
    </Grid>
</Window>
